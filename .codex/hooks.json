{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/target/release/noema-hook\"",
            "timeout": 3,
            "additionalContextLimit": 4000,
            "statusMessage": "Loading Noema context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/target/release/noema-hook\"",
            "timeout": 3,
            "additionalContextLimit": 4000,
            "statusMessage": "Selecting Noema memory"
          }
        ]
      }
    ]
  }
}
